APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Bangkok
USER_MOBILE_ONLY=false

# Opn/Omise PromptPay. Keep false with test keys; change all three values together for live payments.
OPN_LIVE_MODE=false
OPN_PUBLIC_KEY=
OPN_SECRET_KEY=

# Used only by DatabaseSeeder on a fresh installation
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME="ผู้ดูแลระบบ"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=bga-local
REVERB_APP_KEY=bga-local-key
REVERB_APP_SECRET=change-me
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Polygon Amoy external transaction anchoring (testnet only)
POLYGON_ENABLED=false
POLYGON_NETWORK=polygon-amoy
POLYGON_CHAIN_ID=80002
POLYGON_RPC_URL=https://polygon-amoy.drpc.org
POLYGON_PRIVATE_KEY=
POLYGON_ENCRYPTED_WALLET_PATH=polygon/wallet.key
POLYGON_WALLET_ADDRESS_PATH=polygon/address.txt
POLYGON_CONTRACT_ADDRESS=
POLYGON_CONTRACT_INFO_PATH=polygon/contract.json
POLYGON_CONFIRMATIONS=1
POLYGON_PRIORITY_FEE_GWEI=25
POLYGON_MAX_FEE_GWEI=35
POLYGON_EXPLORER_URL=https://amoy.polygonscan.com
